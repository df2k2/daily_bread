---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { entryUrl, shortDate, tagUrl, type Lang } from "../lib/i18n";

interface Props {
  entry: CollectionEntry<"devotionals">;
  lang: Lang;
  viewLabel: string;
}

const { entry, lang, viewLabel } = Astro.props;
const href = entryUrl(lang, entry);
const date = shortDate(entry.data.date, lang);
const tags = entry.data.tags ?? [];
---

<article
  class="flex flex-col gap-3 rounded-xl border p-4 sm:flex-row"
  style="border-color: var(--border)"
>
  {entry.data.image && (
    <a href={href} class="block flex-shrink-0">
      <Image
        src={entry.data.image}
        alt={entry.data.title}
        class="h-28 w-full rounded-lg object-cover sm:w-40"
        loading="lazy"
      />
    </a>
  )}
  <div class="flex flex-1 flex-col gap-1">
    <a href={href}>
      <h3 class="text-lg font-semibold tracking-tight hover:underline">
        {entry.data.title}
      </h3>
    </a>
    <p class="text-xs" style="color: var(--muted-foreground)">
      <span>{date}</span>
      <span class="px-1">·</span>
      <span class="font-medium">{entry.data.reference}</span>
      <span class="opacity-70">({entry.data.translation})</span>
    </p>
    {tags.length > 0 && (
      <div class="mt-1 flex flex-wrap gap-1.5">
        {tags.slice(0, 5).map((tag) => (
          <a
            href={tagUrl(lang, tag)}
            class="rounded-full border px-2 py-0.5 text-[11px] hover:bg-(--muted)"
            style="border-color: var(--border); color: var(--muted-foreground)"
          >
            #{tag}
          </a>
        ))}
      </div>
    )}
    {entry.data.excerpt && (
      <p
        class="mt-1 text-sm leading-relaxed line-clamp-3"
        style="color: var(--foreground)"
      >
        {entry.data.excerpt}
      </p>
    )}
    <a
      href={href}
      class="mt-2 inline-block text-sm font-medium hover:underline"
      style="color: var(--primary)"
    >
      {viewLabel} →
    </a>
  </div>
</article>
