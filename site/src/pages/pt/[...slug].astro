---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { getDevotionalsFor, slugFromId, t } from "../../lib/i18n";

const lang = "pt" as const;

export async function getStaticPaths() {
  const entries = await getDevotionalsFor("pt");
  return entries.map((entry) => ({
    params: { slug: slugFromId(entry.id) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const strings = t(lang);
---

<Base lang={lang} title={`${entry.data.title} — ${strings.site_title}`}>
  <article class="prose-devotional">
    <Content />
  </article>
</Base>
