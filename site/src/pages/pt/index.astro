---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { getDevotionalsFor, t } from "../../lib/i18n";

const lang = "pt" as const;
const all = await getDevotionalsFor(lang);
const latest = all[0];
const rendered = latest ? await render(latest) : null;
const Content = rendered?.Content;
const strings = t(lang);
---

<Base lang={lang} title={latest ? `${latest.data.title} — ${strings.site_title}` : strings.site_title}>
  {!latest && (
    <div class="rounded-xl border p-8 text-center" style="border-color: var(--border)">
      <p class="text-lg font-medium">{strings.no_devotionals}</p>
      <p class="mt-2 text-sm" style="color: var(--muted-foreground)">{strings.placeholder_hint}</p>
    </div>
  )}
  {latest && Content && (
    <article class="prose-devotional">
      <Content />
    </article>
  )}
</Base>
