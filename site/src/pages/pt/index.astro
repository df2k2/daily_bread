---
import Base from "../../layouts/Base.astro";
import PostHero from "../../components/PostHero.astro";
import PostListItem from "../../components/PostListItem.astro";
import { getDevotionalsFor, isSameLocalDay, t, url } from "../../lib/i18n";

const lang = "pt" as const;
const all = await getDevotionalsFor(lang);
const strings = t(lang);

const today = new Date();
const todays = all.filter((e) => isSameLocalDay(e.data.date, today));
const recent = all.filter((e) => !isSameLocalDay(e.data.date, today)).slice(0, 10);

const archiveHref = url(lang, "/archive");
---

<Base lang={lang}>
  {all.length === 0 && (
    <div class="rounded-xl border p-8 text-center" style="border-color: var(--border)">
      <p class="text-lg font-medium">{strings.no_devotionals}</p>
      <p class="mt-2 text-sm" style="color: var(--muted-foreground)">{strings.placeholder_hint}</p>
    </div>
  )}

  {todays.length > 0 && (
    <section class="mb-12">
      <h2 class="mb-4 text-3xl font-semibold tracking-tight">{strings.today}</h2>
      <div class="flex flex-col gap-6">
        {todays.map((entry) => (
          <PostHero entry={entry} lang={lang} readLabel={strings.read_post} />
        ))}
      </div>
    </section>
  )}

  {recent.length > 0 && (
    <section>
      <div class="mb-4 flex items-baseline justify-between">
        <h2 class="text-2xl font-semibold tracking-tight">{strings.recent}</h2>
        <a href={archiveHref} class="text-sm hover:underline" style="color: var(--muted-foreground)">
          {strings.archive} →
        </a>
      </div>
      <div class="flex flex-col gap-3">
        {recent.map((entry) => (
          <PostListItem entry={entry} lang={lang} viewLabel={strings.view} />
        ))}
      </div>
    </section>
  )}
</Base>
