---
import Base from "../../layouts/Base.astro";
import ArchiveSearch from "../../components/ArchiveSearch";
import { t, url } from "../../lib/i18n";

const lang = "pt" as const;
const strings = t(lang);
const indexUrl = `${url(lang)}search-index.json`.replace(/\/{2,}/g, "/");
---

<Base lang={lang} title={`${strings.archive} — ${strings.site_title}`}>
  <h1 class="mb-6 text-2xl font-semibold tracking-tight">{strings.archive_heading}</h1>
  <ArchiveSearch
    client:load
    lang={lang}
    indexUrl={indexUrl}
    placeholder={strings.search_placeholder}
    countLabel={(n, total) => `${n} / ${total}`}
  />
</Base>
